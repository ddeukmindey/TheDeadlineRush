# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# C# & Unity script/config text files
*.cs text diff=csharp eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.shader text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.compute text eol=lf
*.uss text eol=lf
*.uxml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.meta text eol=lf

# Unity YAML Smart Merge
# LƯU Ý: Driver `unityyamlmerge` phải được cấu hình bằng `git config` ở từng máy cá nhân,
# KHÔNG nằm trong `.gitattributes` (vì đường dẫn UnityYAMLMerge phụ thuộc máy/OS).
*.unity merge=unityyamlmerge text eol=lf
*.prefab merge=unityyamlmerge text eol=lf
*.asset merge=unityyamlmerge text eol=lf
*.mat merge=unityyamlmerge text eol=lf
*.controller merge=unityyamlmerge text eol=lf
*.anim merge=unityyamlmerge text eol=lf
*.overrideController merge=unityyamlmerge text eol=lf

# Git LFS cho asset nhị phân / dung lượng lớn
*.png filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
